# PostgreSQL connection string used by the app, migrations and the seed script.
# Local example (Docker / native Postgres):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/returndesk?schema=public"

# Separate database used only by the integration test suite.
# It is reset before every test run, so never point it at real data.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/returndesk_test?schema=public"
